{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Progressive Disclosure Eval Dataset",
  "type": "object",
  "required": ["name", "version", "cases"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "question", "expected_contains", "required_documents", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^EVAL-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "expected_contains": {
            "type": "array",
            "minItems": 1,
            "items": {"type": ["string", "number"]}
          },
          "required_documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "additionalProperties": false
}
